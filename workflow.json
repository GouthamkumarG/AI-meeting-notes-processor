    {
      "parameters": {
        "jsCode": "const pastTranscripts = $('HTTP Request2').all().map(t => t.json.transcript).join(' | ');\nconst newTranscript = $('Webhook').first().json.body.transcript;\n\nconst prompt = 'Past meetings context: ' + pastTranscripts + '. Extract action items from this new transcript. Return ONLY valid JSON: {\"action_items\": [{\"task\": \"\", \"owner\": \"\", \"due_date\": \"\"}], \"summary\": \"\"}. New transcript: ' + newTranscript;\n\nconst body = {\n  model: \"claude-haiku-4-5-20251001\",\n  max_tokens: 1024,\n  messages: [{ role: \"user\", content: prompt }]\n};\n\nreturn [{ json: { body: JSON.stringify(body) } }];"
      },
